                  "pm.sendRequest({ url: pm.variables.replaceIn('{{baseUrl}}/pet'), method: 'POST', header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ id: Number(pm.variables.get('petId')), name: 'qa-setup', photoUrls: [], status: 'available' }) } },",
                  "  (err, res) => { if (err || res.code !== 200) throw new Error('Setup failed: POST /pet');  });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "api_key",
                "value": "special-key"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet/{{petId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                "{{petId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
