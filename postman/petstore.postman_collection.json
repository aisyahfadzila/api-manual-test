  "item": [
    {
      "name": "POST /pet",
      "item": [
        {
          "name": "TC-01 Add pet with all valid fields",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('petId', Date.now() * 1000 + Math.floor(Math.random() * 1000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response matches request', () => { const r = pm.response.json(); pm.expect(r.id).to.eql(Number(pm.variables.get('petId'))); pm.expect(r.name).to.eql('qa-pet-' + pm.variables.get('petId')); pm.expect(r.status).to.eql('available'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{petId}},\n  \"category\": {\"id\": 1, \"name\": \"dogs\"},\n  \"name\": \"qa-pet-{{petId}}\",\n  \"photoUrls\": [\"https://example.com/p.jpg\"],\n  \"tags\": [{\"id\": 1, \"name\": \"qa\"}],\n  \"status\": \"available\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/pet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet"
              ]
            }
          }
        },
